<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="default_payload_stand">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- 诊断实验专用:跟 default.sdf 唯一的差异就是这个模型,静态写在 world
         里、随 world 一起加载,不走运行时 gz service /world/.../create 动态
         spawn。目的是二分排查 payload_stand 导致飞机震荡的根因到底是
         "payload_stand.sdf 模型内容本身"还是"运行时动态 create 这个操作
         本身"——如果用这种方式加载问题消失,就指向后者。 -->
    <model name="payload_stand">
      <static>true</static>
      <pose>2.0 2.0 2.375 0 0 0</pose>
      <link name="stand_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 0.3 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 0.3 0.5</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 诊断实验专用(下一步):跟上面 payload_stand 一样静态写在 world 里,
         但这个模型本身不是 static——它要靠 DetachableJoint 真正焊到飞机
         base_link 上,质量才会算进飞控动力学,所以必须保留为 dynamic body。
         验证目标是:dynamic body 随 world 一起加载(而不是运行时动态
         create)是否也能避免之前确认的震荡问题。位置跟 payload.sdf 一致,
         半块边长落在 payload_stand 顶面上,靠重力+碰撞自然落定。 -->
    <model name="payload">
      <pose>2.0 2.0 2.7 0 0 0</pose>
      <link name="payload_link">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.005625</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.005625</iyy>
            <iyz>0</iyz>
            <izz>0.005625</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.15 0.15 0.15</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.1 1</ambient>
            <diffuse>0.8 0.2 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.15 0.15 0.15</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
